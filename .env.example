# Copy to .env.local (local) and add the same two values in Vercel → Project → Settings → Environment Variables.
# Both are public by design (they ship to the browser); the row-level security rules in
# supabase/migrations/0001_progress.sql are what keep each account's data private.
# Never put the service_role / secret key here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
